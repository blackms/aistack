# Version control
.git
.gitignore
.gitattributes

# Build artifacts (rebuilt inside image)
dist
coverage
*.tsbuildinfo

# Dependencies (installed inside image)
node_modules

# Local state
data
*.db
*.db-journal
*.db-shm
*.db-wal

# Environment & secrets
.env
.env.*
!.env.example

# Tests & dev tooling
tests
vitest.config.ts
vitest.integration.config.ts
vitest.e2e.config.ts
.eslintrc.json
eslint.config.js
.prettierrc

# Docs (kept out of image to reduce size; available in repo)
docs
*.md
!README.md

# IDE / OS
.idea
.vscode
.DS_Store
Thumbs.db
*.swp
*.swo

# Logs & caches
*.log
npm-debug.log*
.cache
.npm
.eslintcache

# Web sub-project (built separately, not needed in CLI image)
web

# Docker / Helm / CI metadata (no need inside image)
Dockerfile
.dockerignore
docker-compose*.yml
charts
.github
codecov.yml

# Temporary files
*.tmp
*.temp
*.backup
